[Unit]
Description=Finance Track (db + backend + frontend) via docker compose
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/apps/finance-track
RemainAfterExit=yes
ExecStart=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target

