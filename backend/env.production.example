# App
NODE_ENV=production
APP_PORT=3000

# CORS (comma-separated). With nginx proxy on same domain you can keep it strict.
CORS_ORIGINS=https://www.finance-track.ru,https://finance-track.ru

# JWT
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Postgres (docker-compose uses service name "db" as HOST)
HOST=db
PORT=5432
NAMEUSER=finance
PASSWORD=finance_password_change_me
DATABASE=finance_track

# TypeORM
TYPEORM_SYNC=true
TYPEORM_LOGGING=false

# Seed (creates roles + admin user + default catalogs)
SEED_ON_STARTUP=true
SEED_ADMIN_EMAIL=admin@finance-track.ru
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SEED_ADMIN_PHONE=+79990000000
SEED_ADMIN_NAME=Admin
SEED_ADMIN_SURNAME=Finance

